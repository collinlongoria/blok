#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

struct Sv64Node {
    uint64_t childMask;      // 64-bit mask
    uint     firstChild;     // Index into global array
    uint     materialId;
    float    occupancy;
    uint     mortonPrefix;
    uint     childCount;
    uint     reserved;
};

struct SubChunkGpu {
    uint nodeOffset;        // Offset into global node array
    uint rootNodeIndex;     // Sub-chunk's root node
    uint nodeCount;         // Total nodes in parent chunk
    uint startDepth;        // Depth at which sub-chunk starts
    vec3 worldMin;
    float subChunkSize;
    vec3 worldMax;
    float pad0;
};

layout(binding = 1, set = 0, scalar) readonly buffer Sv64Buffer {
    Sv64Node nodes[];
};

layout(binding = 2, set = 0, scalar) readonly buffer SubChunkBuffer {
    SubChunkGpu subChunks[];
};

struct HitAttribs {
    uint materialId;
};
hitAttributeEXT HitAttribs hitAttribs;

const uint MAX_STACK = 32u;
const uint MAX_ITER  = 512u;
const float EPSILON  = 1e-5;

uint popcount64(uint64_t v) {
    return bitCount(uint(v)) + bitCount(uint(v >> 32));
}

uint getChildOffset(uint64_t mask, uint childIdx) {
    uint64_t lowerMask = mask & ((1ul << childIdx) - 1ul);
    return popcount64(lowerMask);
}

vec2 intersectAABB(vec3 origin, vec3 invDir, vec3 boxMin, vec3 boxMax) {
    vec3 t0 = (boxMin - origin) * invDir;
    vec3 t1 = (boxMax - origin) * invDir;
    vec3 tmin = min(t0, t1);
    vec3 tmax = max(t0, t1);
    float tNear = max(max(tmin.x, tmin.y), tmin.z);
    float tFar  = min(min(tmax.x, tmax.y), tmax.z);
    return vec2(tNear, tFar);
}

uint getHitFace(vec3 hitPos, vec3 center) {
    vec3 diff = hitPos - center;
    vec3 absDiff = abs(diff);
    if (absDiff.x >= absDiff.y && absDiff.x >= absDiff.z)
        return diff.x > 0.0 ? 0u : 1u; // +X, -X
    if (absDiff.y >= absDiff.z)
        return diff.y > 0.0 ? 2u : 3u; // +Y, -Y
    return diff.z > 0.0 ? 4u : 5u; // +Z, -Z
}

struct StackItem {
    uint nodeIndex;
    vec3 minPos;
    float size; // edge length
};

void main() {
    SubChunkGpu sub = subChunks[gl_PrimitiveID];

    vec3 rayOrg = gl_WorldRayOriginEXT;
    vec3 rayDir = gl_WorldRayDirectionEXT;

    vec3 invDir = 1.0 / mix(rayDir, vec3(1e-6), lessThan(abs(rayDir), vec3(1e-6)));

    ivec3 stepSign = ivec3(sign(rayDir));
    vec3  posStep  = vec3(stepSign); // +1.0 or -1.0

    vec2 rootT = intersectAABB(rayOrg, invDir, sub.worldMin, sub.worldMax);

    float tMin = max(rootT.x, gl_RayTminEXT);
    float tMax = min(rootT.y, gl_RayTmaxEXT);

    if (tMin > tMax) return;

    StackItem stack[MAX_STACK];
    uint stackPtr = 0u;

    stack[stackPtr++] = StackItem(
        sub.nodeOffset + sub.rootNodeIndex,
        sub.worldMin,
        sub.subChunkSize
    );

    uint iter = 0u;

    while (stackPtr > 0u && iter++ < MAX_ITER) {
        StackItem item = stack[--stackPtr];

        vec3 nodeMax = item.minPos + vec3(item.size);
        vec2 nodeT = intersectAABB(rayOrg, invDir, item.minPos, nodeMax);

        float tEnter = max(nodeT.x, tMin);
        float tExit  = min(nodeT.y, tMax);

        if (tEnter > tExit) continue;

        Sv64Node node = nodes[item.nodeIndex];

        if (node.childMask == 0ul) {
            if (node.occupancy > 0.0) {
                vec3 center = item.minPos + vec3(item.size * 0.5);
                uint faceID = getHitFace(rayOrg + rayDir * tEnter, center);

                hitAttribs.materialId = node.materialId;
                reportIntersectionEXT(tEnter, faceID);
            }
            continue;
        }

        float voxelSize = item.size * 0.25; // size / 4

        vec3 entryPos = rayOrg + rayDir * (tEnter + EPSILON);
        vec3 localPos = (entryPos - item.minPos) / voxelSize;

        ivec3 gridPos = clamp(ivec3(floor(localPos)), ivec3(0), ivec3(3));

        vec3 tDelta = (vec3(voxelSize) * posStep) * invDir; // abs() logic simplified

        vec3 nextBoundary = (vec3(gridPos) + max(vec3(0), posStep)) * voxelSize + item.minPos;
        vec3 tNext = (nextBoundary - rayOrg) * invDir;

        struct ChildHit { uint index; vec3 pos; };
        ChildHit childHits[12]; // Max path length in 4x4x4 is 4+4+4=12
        uint hitCount = 0u;

        for (int step = 0; step < 16; ++step) {
            uint childIdx = uint(gridPos.x) | (uint(gridPos.y) << 2) | (uint(gridPos.z) << 4);

            if ((node.childMask & (1ul << childIdx)) != 0ul) {
                uint offset = getChildOffset(node.childMask, childIdx);
                uint childNodeIndex = node.firstChild + offset;

                vec3 childPos = item.minPos + vec3(gridPos) * voxelSize;

                if (hitCount < 12) {
                    childHits[hitCount++] = ChildHit(childNodeIndex, childPos);
                }
            }

            float tNextMin = min(min(tNext.x, tNext.y), tNext.z);

            if (tNextMin > tExit) break;

            if (tNext.x <= tNext.y && tNext.x <= tNext.z) {
                tNext.x += tDelta.x;
                gridPos.x += stepSign.x;
                if (gridPos.x < 0 || gridPos.x > 3) break;
            } else if (tNext.y <= tNext.z) {
                tNext.y += tDelta.y;
                gridPos.y += stepSign.y;
                if (gridPos.y < 0 || gridPos.y > 3) break;
            } else {
                tNext.z += tDelta.z;
                gridPos.z += stepSign.z;
                if (gridPos.z < 0 || gridPos.z > 3) break;
            }
        }

        for (int i = int(hitCount) - 1; i >= 0; --i) {
            if (stackPtr < MAX_STACK) {
                stack[stackPtr++] = StackItem(
                    childHits[i].index,
                    childHits[i].pos,
                    voxelSize
                );
            }
        }
    }
}